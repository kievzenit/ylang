; ModuleID = 'main'
source_filename = "main"

%Outer = type { %Inner, i32 }
%Inner = type { i32, i32 }

define i32 @main() #0 {
alloc:
  %o = alloca %Outer, align 8
  %p = alloca ptr, align 8
  br label %entry

entry:                                            ; preds = %alloc
  %"Outer::inner" = getelementptr inbounds nuw %Outer, ptr %o, i32 0, i32 0
  %"Inner::x" = getelementptr inbounds nuw %Inner, ptr %"Outer::inner", i32 0, i32 0
  store i32 1, ptr %"Inner::x", align 4
  %"Inner::y" = getelementptr inbounds nuw %Inner, ptr %"Outer::inner", i32 0, i32 1
  store i32 2, ptr %"Inner::y", align 4
  %"Outer::tag" = getelementptr inbounds nuw %Outer, ptr %o, i32 0, i32 1
  store i32 3, ptr %"Outer::tag", align 4
  %"Outer::inner1" = getelementptr inbounds nuw %Outer, ptr %o, i32 0, i32 0
  %"Inner::x2" = getelementptr inbounds nuw %Inner, ptr %"Outer::inner1", i32 0, i32 0
  store i32 10, ptr %"Inner::x2", align 4
  store ptr %o, ptr %p, align 8
  %loadtmp = load ptr, ptr %p, align 8
  %"Outer::tag3" = getelementptr inbounds nuw %Outer, ptr %loadtmp, i32 0, i32 1
  store i32 4, ptr %"Outer::tag3", align 4
  %"Outer::inner4" = getelementptr inbounds nuw %Outer, ptr %o, i32 0, i32 0
  %"Inner::x5" = getelementptr inbounds nuw %Inner, ptr %"Outer::inner4", i32 0, i32 0
  %memberaccesstmp = load i32, ptr %"Inner::x5", align 4
  %"Outer::inner6" = getelementptr inbounds nuw %Outer, ptr %o, i32 0, i32 0
  %"Inner::y7" = getelementptr inbounds nuw %Inner, ptr %"Outer::inner6", i32 0, i32 1
  %memberaccesstmp8 = load i32, ptr %"Inner::y7", align 4
  %addtmp = add i32 %memberaccesstmp, %memberaccesstmp8
  %loadtmp9 = load ptr, ptr %p, align 8
  %"Outer::tag10" = getelementptr inbounds nuw %Outer, ptr %loadtmp9, i32 0, i32 1
  %memberaccesstmp11 = load i32, ptr %"Outer::tag10", align 4
  %addtmp12 = add i32 %addtmp, %memberaccesstmp11
  ret i32 %addtmp12

unreachable:                                      ; No predecessors!
  unreachable
}

attributes #0 = { "frame-pointer"="all" "no-trapping-math"="true" "stack-protector-buffer-size"="8" }
